{
  "name": "conductor",
  "version": "0.1.0",
  "private": true,
  "description": "Local dashboard and board that runs your AI coding CLIs as a team: Claude plans, Cursor builds, Claude verifies \u2014 with bug loops, in isolated git worktrees.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TechTeamConductor/Conductor.git"
  },
  "homepage": "https://github.com/TechTeamConductor/Conductor",
  "bugs": {
    "url": "https://github.com/TechTeamConductor/Conductor/issues"
  },
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "conductor": "bin/conductor.mjs"
  },
  "scripts": {
    "start": "node bin/conductor.mjs start",
    "demo": "node bin/conductor.mjs demo",
    "doctor": "node bin/conductor.mjs doctor",
    "open": "node bin/conductor.mjs open",
    "test": "node --test --import ./test/preload.ts --test-concurrency=4 \"test/**/*.test.ts\"",
    "test:live": "LIVE=1 node --test --import ./test/preload.ts --test-concurrency=1 \"test/live/**/*.test.ts\"",
    "check": "tsc --noEmit",
    "release:version": "node scripts/next-version.ts",
    "check:workflows": "node scripts/check-workflows.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.0"
  }
}
