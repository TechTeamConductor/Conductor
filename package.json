{
  "name": "techteam-conductor",
  "version": "0.1.0",
  "private": true,
  "description": "Local master UI and board that runs cards through Claude (plan) -> Cursor (build) -> Claude (verify) with bug loops.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "conductor": "bin/conductor.mjs"
  },
  "scripts": {
    "start": "node bin/conductor.mjs start",
    "demo": "node bin/conductor.mjs demo",
    "doctor": "node bin/conductor.mjs doctor",
    "open": "node bin/conductor.mjs open",
    "test": "node --test --import ./test/preload.ts --test-concurrency=4 \"test/**/*.test.ts\"",
    "test:live": "LIVE=1 node --test --import ./test/preload.ts --test-concurrency=1 \"test/live/**/*.test.ts\"",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
